# SETU backend configuration — copy to .env and adjust.
# Database: SQLite (file-based, zero-configuration, offline-proof).
DATABASE_PATH=./setu.db
DEMO_MODE=false
USE_MOCK_DATA=false
ALGORITHM_VERSION=setu-1.0.0
# Optional: LLM API key for mandate parsing (rule-based fallback always works)
LLM_API_KEY=
